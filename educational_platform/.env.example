# ====================================================
# پلتفرم آموزشی محلی — مشابه شاد
# Local Educational Platform (SHAD-like)
# ====================================================
#
# کپی این فایل به .env و مقادیر را تنظیم کنید
# Copy this file to .env and configure values
#
# cp .env.example .env
# nano .env

# ---- دامنه / Domain --------------------------------
# آدرس کامل سایت (با http:// یا https://)
ROOT_URL=http://localhost:3000

# ---- رمزهای عبور / Passwords ----------------------
# رمز عبور ادمین اولیه (بعد از راه‌اندازی تغییر دهید)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_EMAIL=admin@school.local

# رمز MongoDB
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=ChangeMongoPassword456!
MONGO_DB=rocketchat

# رمز MinIO (ذخیره‌سازی فایل)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMinioPassword789!
MINIO_BUCKET=rocketchat

# ---- تنظیمات سرور / Server Settings ---------------
# پورت Rocket.Chat (بدون SSL)
ROCKETCHAT_PORT=3000

# پورت Nginx (با SSL: 443)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- حافظه Node.js / Node.js Memory ----------------
# برای 100 کاربر: 2048 کافی است
# برای 200 کاربر: 4096 توصیه می‌شود
NODE_MAX_MEMORY=2048

# ---- تنظیمات MongoDB / MongoDB Settings -----------
# برای محیط production، Replica Set الزامی است
MONGO_REPLICA_SET_NAME=rs0

# ---- ایمیل / Email (اختیاری) ---------------------
# برای ارسال ایمیل فعال‌سازی و بازنشانی رمز
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@school.local

# ---- ویدیو کنفرانس / Video Conference (اختیاری) --
# می‌توانید از meet.jit.si رایگان استفاده کنید
JITSI_DOMAIN=meet.jit.si
JITSI_ENABLED=true

# ---- تنظیمات اسکریپت init-users.js ----------------
# فقط برای تست محلی با گواهی SSL خود-امضا، true قرار دهید
# In production with a valid SSL cert, leave this as false
RC_ALLOW_SELF_SIGNED=false
